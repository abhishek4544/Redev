{
  "name": "redev-cli",
  "version": "0.3.11",
  "description": "Terminal-first click-to-edit tool. Click any element in your dev app, describe the change, ship it via Claude Code.",
  "keywords": [
    "cli",
    "ink",
    "claude",
    "claude-code",
    "developer-tools",
    "react",
    "vite",
    "tailwind",
    "click-to-edit"
  ],
  "type": "module",
  "bin": {
    "redev": "dist/index.js",
    "redev-cli": "dist/index.js",
    "redev-mcp": "dist/mcp/redev-mcp.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsc && chmod +x dist/index.js dist/mcp/redev-mcp.js",
    "test": "npm run build && node --test test/discovery.test.mjs",
    "start": "node dist/index.js",
    "demo": "tsx src/index.tsx --demo",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "abhishek4544",
  "license": "MIT",
  "homepage": "https://github.com/abhishek4544/Redev#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhishek4544/Redev.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/abhishek4544/Redev/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bundleDependencies": [
    "react",
    "ink",
    "ink-spinner",
    "ink-text-input",
    "ink-select-input"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chalk": "^5.3.0",
    "cli-highlight": "^2.1.11",
    "cors": "^2.8.6",
    "diff": "^5.2.0",
    "express": "^4.22.2",
    "http-proxy-middleware": "^4.2.0",
    "ink": "^5.0.1",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/diff": "^5.0.9",
    "@types/react": "^18.2.43",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.0",
    "typescript": "^5.2.2"
  }
}
