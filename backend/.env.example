# Server ports
PORT=5050
WS_PORT=3001

# Anthropic API key — required for Claude to generate edits
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Absolute path to the React project Redev should edit
# Files with data-redev-file="components/Button.tsx" will resolve to
# $REDEV_PROJECT_ROOT/components/Button.tsx
REDEV_PROJECT_ROOT=/absolute/path/to/your/react/project

NODE_ENV=development
